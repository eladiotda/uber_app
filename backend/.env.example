# Copia este archivo como .env (NO se sube a GitHub). Solo credenciales de PRUEBA.
# Access Token de PRUEBA del vendedor de prueba de Mercado Pago (empieza por APP_USR- o TEST-).
MP_ACCESS_TOKEN=APP_USR-1508071762940710-110923-aca1a8eca3d7a4947c1529a4e54586d8-3831699216
# URL pública del backend (ngrok o Render), sin "/" al final. Ej: https://abcd-1234.ngrok-free.app
PUBLIC_URL=
# Ruta al JSON de la cuenta de servicio de Firebase (Configuración > Cuentas de servicio). NO se sube a GitHub.
FIREBASE_SERVICE_ACCOUNT_FILE=./service-account.json
PORT=3000
